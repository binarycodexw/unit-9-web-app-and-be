<%- include('partials/header') %>

<section class="hero">
  <h1>Track the stocks you care about, securely.</h1>
  <p class="lead">
    Build watchlists, keep private notes, review price history and set target prices.
    Your account is protected with Argon2id password hashing and optional two-factor authentication.
  </p>
  <p class="actions">
    <a class="button" href="/register">Create a free account</a>
    <a class="button button-secondary" href="/login">Sign in</a>
  </p>
</section>

<section class="grid grid-3">
  <article class="card">
    <h2>Watchlists</h2>
    <p>Group stocks into named lists, add notes and target prices, and see the latest price at a glance.</p>
  </article>
  <article class="card">
    <h2>Price history</h2>
    <p>Browse the stock catalogue and inspect a 30, 60 or 100-day price chart with daily open, high, low and close.</p>
  </article>
  <article class="card">
    <h2>Target prices</h2>
    <p>Set the price you are aiming for and see it drawn on the stock's chart next to the real price.</p>
  </article>
</section>

<%- include('partials/footer') %>
