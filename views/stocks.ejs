<%- include('partials/header') %>

<h1>Stocks</h1>

<section class="card">
  <form method="get" action="/stocks" class="form form-inline" data-validate novalidate>
    <div class="field">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" maxlength="60" value="<%= filters.q %>" placeholder="Symbol or name">
    </div>
    <div class="field">
      <label for="sector">Sector</label>
      <select id="sector" name="sector">
        <option value="">All sectors</option>
        <% sectors.forEach((sector) => { %>
          <option value="<%= sector %>" <%= filters.sector === sector ? 'selected' : '' %>><%= sector %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="button">Filter</button>
    <a class="button button-secondary" href="/stocks">Reset</a>
  </form>
</section>

<section class="card">
  <p class="muted"><%= totalResults %> result<%= totalResults === 1 ? '' : 's' %></p>
  <% if (stocks.length === 0) { %>
    <p>No stock matches your search.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Symbol</th><th scope="col">Name</th><th scope="col">Sector</th>
            <th scope="col" class="num">Last price</th><th scope="col">Updated</th>
          </tr>
        </thead>
        <tbody>
          <% stocks.forEach((stock) => { %>
            <tr>
              <td><a href="/stocks/<%= stock.symbol %>"><strong><%= stock.symbol %></strong></a></td>
              <td><%= stock.name %></td>
              <td><%= stock.sector %></td>
              <td class="num"><%= fmtPrice(stock.last_price) %></td>
              <td><%= fmtDate(stock.last_price_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
      <nav class="pagination" aria-label="Pagination">
        <% for (let p = 1; p <= pages; p += 1) { %>
          <% if (p === filters.page) { %>
            <span class="page current" aria-current="page"><%= p %></span>
          <% } else { %>
            <a class="page" href="/stocks?q=<%= encodeURIComponent(filters.q) %>&amp;sector=<%= encodeURIComponent(filters.sector) %>&amp;page=<%= p %>"><%= p %></a>
          <% } %>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</section>

<%- include('partials/footer') %>
