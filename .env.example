# Copy to .env and fill in the values. Do not commit .env.

NODE_ENV=development
PORT=3000

# matches docker-compose.yml
DATABASE_URL=postgresql://watchlist:change_me@localhost:5433/watchlist
# true if the database needs TLS (Neon, Supabase, Render...)
DATABASE_SSL=false

# at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# 64 hex characters, encrypts the MFA secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# https://www.alphavantage.co/support/#api-key
# optional, without it the sample prices from the seed are used
ALPHAVANTAGE_API_KEY=
# a price is refreshed when its stock page is opened and it is older than this
PRICE_MAX_AGE_HOURS=12
# max api calls per day (the free plan allows 25)
API_DAILY_BUDGET=20

# only used by "npm run db:seed" to create the admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
